---
import { marked } from "marked";
import ResumeVariantSelect from "../components/ResumeVariantSelect.astro";
import { resumeVariants } from "../content/resume-variants";
---

<link rel="stylesheet" href="/styles/resume.css" />
{resumeVariants.map(({ key, md }) => (
    <article class="resume-preview prose" data-resume-variant={key} hidden={key !== ""} set:html={marked.parse(md)}/>
))}
<ResumeVariantSelect />
